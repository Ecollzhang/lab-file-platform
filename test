def fast_sort(arr):

    if len(arr) <= 1:
        return arr

    center = len(arr) // 2
    left = 0
    right = len(arr) - 1

    i = left
    j = right
    while left < right:

        while arr[i] < arr[center]:
            i += 1

        while arr[j] > arr[center]:
            j -= 1

        if i < j:
            arr[i], arr[j] = arr[j], arr[i]

    leftArr = fast_sort(arr[:center])
    rightArr = fast_sort(arr[center+1:])

    return leftArr + rightArr

